    <DTS:Executable
      DTS:refId="Package\Selecting the maximum date in DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{659b56cb-901f-4d30-91b9-aa069b9967b2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Selecting the maximum date in DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7A58D430-0281-4137-AAA6-4D23177805AC}"
          SQLTask:SqlStatementSource="SELECT ISNULL(MAX(FullDate), '2019-01-01') AS MaxDimDate FROM DimDate&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="MaxDimDate"
            SQLTask:DtsVariableName="User::MaxDimDate" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\selecting the minimum and maximum date in stg_CrimeData"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6bfd4e86-72ae-4ca5-b587-81fae95ee785}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="selecting the minimum and maximum date in stg_CrimeData"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7A58D430-0281-4137-AAA6-4D23177805AC}"
          SQLTask:SqlStatementSource="SELECT &#xA;    ISNULL(MIN(CAST(ISNULL(DateReported, DateOfOccurrence) AS DATE)), '2020-01-01') AS MinStgDate,&#xA;    ISNULL(MAX(CAST(ISNULL(DateReported, DateOfOccurrence) AS DATE)), '2020-01-01') AS MaxStgDate&#xA;FROM stg_CrimeData&#xA;WHERE DateReported IS NOT NULL OR DateOfOccurrence IS NOT NULL;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="MinStgDate"
            SQLTask:DtsVariableName="User::MinStgDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="MaxStgDate"
            SQLTask:DtsVariableName="User::MaxStgDate" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
