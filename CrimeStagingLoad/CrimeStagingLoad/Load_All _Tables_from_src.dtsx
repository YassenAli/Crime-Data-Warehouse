  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3BC20810-0A43-4326-89D0-3D053CE087E4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7A58D430-0281-4137-AAA6-4D23177805AC}"
          SQLTask:SqlStatementSource="CREATE TABLE dbo.CrimeFinalWC&#xA;(&#xA;  [Digital Record Number]      VARCHAR(12)    NULL,&#xA;  [Date Reported]              VARCHAR(10)    NULL,&#xA;  [Date of Occurrence]         VARCHAR(10)    NULL,&#xA;  [Time of Occurrence]         VARCHAR(4)     NULL,&#xA;  [AreaCode]                   VARCHAR(7)     NULL,&#xA;  [Area Name]                  VARCHAR(255)   NULL,&#xA;  [SubArea Number]             VARCHAR(7)     NULL,&#xA;  [Crime Code]                 VARCHAR(7)     NULL,&#xA;  [CrimeCodeDescription]       VARCHAR(255)   NULL,&#xA;  [ModusOperandiCodes]         VARCHAR(255)   NULL,&#xA;  [Victim Age]                 VARCHAR(255)    NULL,&#xA;  [Victim Gender]              VARCHAR(255)     NULL,&#xA;  [Victim OriginalCountry]     VARCHAR(255)   NULL,&#xA;  [Premise Code]               VARCHAR(255)     NULL,&#xA;  [PremiseDescription]         VARCHAR(255)   NULL,&#xA;  [Weapon Used Code]           VARCHAR(255)     NULL,&#xA;  [Weapon Description]         VARCHAR(255)   NULL,&#xA;  [Status]                     VARCHAR(255)     NULL,&#xA;  [Status Desc]                VARCHAR(255)   NULL,&#xA;  [Latitude]                   VARCHAR(255)    NULL,&#xA;  [Longitude]                  VARCHAR(255)    NULL,&#xA;  [Location]                   VARCHAR(255)   NULL&#xA;);&#xA;GO&#xA;&#xA;BULK INSERT dbo.CrimeFinalWC&#xA;FROM 'Y:\FCAI\Level 3\Second Semester\Data Warehouse\Assignments\Project\archive\Crime_Data_WC_Final_denormalized.csv'&#xA;WITH&#xA;(&#xA;  FIRSTROW         = 2,          -- skip header&#xA;  FIELDTERMINATOR  = ',',&#xA;  ROWTERMINATOR    = '\n',&#xA;  CODEPAGE         = '65001',     -- or '1252' if ANSI&#xA;  TABLOCK&#xA;);&#xA;GO&#xA;&#xA;INSERT INTO dbo.CrimeCodeDescription (CrimeCode, CrimeCodeDescription)&#xA;SELECT DISTINCT&#xA;    t.[Crime Code],&#xA;    t.CrimeCodeDescription&#xA;FROM dbo.CrimeFinalWC AS t&#xA;LEFT JOIN dbo.CrimeCodeDescription AS d&#xA;    ON d.CrimeCode = t.[Crime Code]&#xA;WHERE t.[Crime Code]     IS NOT NULL&#xA;  AND t.[Crime Code]     &lt;&gt; ''&#xA;  AND d.CrimeCode        IS NULL;&#xA;  -------------------&#xA;&#xA;BEGIN TRAN;&#xA;&#xA;-- 1) Trim whitespace everywhere&#xA;UPDATE dbo.CrimeFinalWC&#xA;SET &#xA;    [Premise Code]       = LTRIM(RTRIM([Premise Code])),&#xA;    [Weapon Used Code]   = LTRIM(RTRIM([Weapon Used Code])),&#xA;    [Status]             = UPPER(LTRIM(RTRIM([Status])));&#xA;&#xA;-- 2) Extract only leading digits for Premise Code&#xA;--    e.g. '0100 03' → '0100'; non-numeric → NULL&#xA;UPDATE dbo.CrimeFinalWC&#xA;SET [Premise Code] = CASE &#xA;  WHEN PATINDEX('[0-9]%', [Premise Code]) = 1&#xA;    THEN LEFT([Premise Code],&#xA;              NULLIF(CHARINDEX(' ', [Premise Code] + ' ')-1, -1)&#xA;             )&#xA;  ELSE NULL&#xA;END;&#xA;&#xA;-- 3) Extract only leading digits for Weapon Used Code&#xA;--    e.g. '101ABC' → '101'; non-digit prefix → NULL&#xA;UPDATE dbo.CrimeFinalWC&#xA;SET [Weapon Used Code] = CASE &#xA;  WHEN PATINDEX('[0-9]%', [Weapon Used Code]) = 1&#xA;    THEN LEFT([Weapon Used Code],&#xA;              ISNULL(NULLIF(CHARINDEX(' ', [Weapon Used Code] + ' ')-1, -1),&#xA;                     LEN([Weapon Used Code])&#xA;              )&#xA;             )&#xA;  ELSE NULL&#xA;END;&#xA;&#xA;-- 4) Drop any non-two-letter status codes&#xA;UPDATE dbo.CrimeFinalWC&#xA;SET [Status] = NULL&#xA;WHERE NOT ([Status] LIKE '[A-Z][A-Z]');&#xA;&#xA;&#xA;-- 5) Remove rows that still have no valid keys&#xA;DELETE t&#xA;FROM dbo.CrimeFinalWC AS t&#xA;LEFT JOIN dbo.AreaCodeDescription AS a ON a.AreaCode = t.AreaCode&#xA;LEFT JOIN dbo.CrimeCodeDescription AS c ON c.CrimeCode = t.[Crime Code]&#xA;LEFT JOIN dbo.PremiseCodeDescription AS p ON p.PremiseCode = t.[Premise Code]&#xA;LEFT JOIN dbo.WeaponCodeDescription AS w ON w.WeaponUsedCode = t.[Weapon Used Code]&#xA;LEFT JOIN dbo.StatusCodeDescription AS s ON s.Status = t.[Status]&#xA;WHERE&#xA;   a.AreaCode        IS NULL  -- area codes should already be complete&#xA;   OR c.CrimeCode     IS NULL&#xA;   OR p.PremiseCode   IS NULL&#xA;   OR w.WeaponUsedCode IS NULL&#xA;   OR s.Status        IS NULL;&#xA;&#xA;-- 6) Quick validation: how many rows remain?&#xA;SELECT COUNT(*) AS CleanRows&#xA;FROM dbo.CrimeFinalWC;&#xA;&#xA;COMMIT;&#xA;GO&#xA;&#xA;&#xA;INSERT INTO dbo.WeaponCodeDescription (WeaponUsedCode, WeaponDescription)&#xA;SELECT DISTINCT&#xA;    CleanCode,&#xA;    LTRIM(RTRIM([Weapon Description])) AS CleanDesc&#xA;FROM dbo.CrimeFinalWC&#xA;CROSS APPLY&#xA;(&#xA;  SELECT LTRIM(RTRIM([Weapon Used Code])) AS CleanCode&#xA;) AS x&#xA;WHERE&#xA;  CleanCode LIKE '[0-9]%'        -- must start with a digit&#xA;  AND LEN(CleanCode) &lt;= 7        -- fit your VARCHAR(7)&#xA;  AND NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.WeaponCodeDescription d&#xA;    WHERE d.WeaponUsedCode = x.CleanCode&#xA;  );&#xA;&#xA;INSERT INTO dbo.PremiseCodeDescription (PremiseCode, PremiseDescription)&#xA;SELECT DISTINCT&#xA;    CleanCode,&#xA;    CleanDesc&#xA;FROM&#xA;(&#xA;  SELECT&#xA;    -- strip spaces &amp; take everything up to first blank&#xA;    LEFT(&#xA;      LTRIM(RTRIM([Premise Code])),&#xA;      CHARINDEX(' ', LTRIM(RTRIM([Premise Code])) + ' ') - 1&#xA;    ) AS CleanCode,&#xA;    LTRIM(RTRIM(PremiseDescription)) AS CleanDesc&#xA;  FROM dbo.CrimeFinalWC&#xA;) AS src&#xA;WHERE&#xA;  CleanCode &lt;&gt; ''&#xA;  AND NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.PremiseCodeDescription d&#xA;    WHERE d.PremiseCode = src.CleanCode&#xA;  );&#xA; SELECT DISTINCT [Status]&#xA;FROM dbo.CrimeFinalWC&#xA;EXCEPT&#xA;SELECT Status&#xA;FROM dbo.StatusCodeDescription;&#xA;&#xA;INSERT INTO dbo.StatusCodeDescription (Status, StatusDesc)&#xA;SELECT DISTINCT&#xA;    LTRIM(RTRIM(t.[Status]))   AS CleanStatus,&#xA;    t.[Status Desc]&#xA;FROM dbo.CrimeFinalWC AS t&#xA;LEFT JOIN dbo.StatusCodeDescription AS d&#xA;  ON d.Status = LTRIM(RTRIM(t.[Status]))&#xA;WHERE&#xA;  -- Must be exactly two uppercase letters (e.g. 'AA', 'IC', 'JA')&#xA;  LTRIM(RTRIM(t.[Status])) LIKE '[A-Z][A-Z]'&#xA;  AND d.Status IS NULL;&#xA;&#xA;&#xA;&#xA;&#xA;BEGIN TRAN;&#xA;&#xA;INSERT INTO dbo.CrimeDataNormalized( DigitalRecordNumber, DateReported, DateOfOccurrence, TimeOfOccurrence, AreaCode, SubAreaNumber, CrimeCode, PremiseCode, WeaponUsedCode, [Status]&#xA;, VictimAge,    VictimGender, VictimOriginalCountry, Latitude,     Longitude,    [Location])&#xA;SELECT&#xA;  t.[Digital Record Number],&#xA;&#xA;  -- convert m/d/yyyy strings to DATE&#xA;  TRY_CONVERT(date, NULLIF(t.[Date Reported], ''), 101),&#xA;  TRY_CONVERT(date, NULLIF(t.[Date of Occurrence], ''), 101),&#xA;&#xA;  -- inject colon into hhmm and convert to TIME&#xA;  TRY_CONVERT(time, STUFF(NULLIF(t.[Time of Occurrence], ''), 3, 0, ':'), 108),&#xA;&#xA;  -- direct code from file (already normalized)&#xA;  NULLIF(t.AreaCode, ''),&#xA;  NULLIF(t.[SubArea Number], ''),&#xA;  NULLIF(t.[Crime Code], ''),&#xA;  NULLIF(t.[Premise Code], ''),&#xA;  NULLIF(t.[Weapon Used Code], ''),&#xA;  NULLIF(t.[Status], ''),&#xA;&#xA;  -- numeric casts&#xA;  TRY_CAST(NULLIF(t.[Victim Age], '') AS INT),&#xA;&#xA;  NULLIF(t.[Victim Gender], ''),&#xA;  NULLIF(t.[Victim OriginalCountry], ''),&#xA;&#xA;  TRY_CAST(NULLIF(t.Latitude, '') AS FLOAT),&#xA;  TRY_CAST(NULLIF(t.Longitude, '') AS FLOAT),&#xA;&#xA;  NULLIF(t.Location, '')&#xA;&#xA;FROM dbo.CrimeFinalWC AS t&#xA;&#xA;  /* Join‐back for descriptions if you need to enforce valid keys.&#xA;     If you trust the file’s codes, you can skip these joins. */&#xA;  INNER JOIN dbo.AreaCodeDescription       AS a ON a.AreaCode            = t.AreaCode&#xA;  INNER JOIN dbo.CrimeCodeDescription      AS c ON c.CrimeCode           = t.[Crime Code]&#xA;  INNER JOIN dbo.PremiseCodeDescription    AS p ON p.PremiseCode         = t.[Premise Code]&#xA;  INNER JOIN dbo.WeaponCodeDescription     AS w ON w.WeaponUsedCode      = t.[Weapon Used Code]&#xA;  INNER JOIN dbo.StatusCodeDescription     AS s ON s.Status              = t.[Status]&#xA;WHERE&#xA;  a.AreaCode            IS NOT NULL&#xA;  AND c.CrimeCode        IS NOT NULL&#xA;  AND p.PremiseCode      IS NOT NULL&#xA;  AND w.WeaponUsedCode   IS NOT NULL&#xA;  AND s.Status           IS NOT NULL;&#xA;;&#xA;&#xA;IF @@ERROR = 0&#xA;  COMMIT;&#xA;ELSE&#xA;  ROLLBACK;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load_Area"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{b332f1a3-a9ac-4cad-9c6c-99e2a323923b}"
